<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= t.formTitle %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <main>
      <%- include('partials/lang-switch') %>
      <h1><%= t.formTitle %></h1>
      <p class="side"><%= side.formTitle %></p>
      <p><%= t.formLead %></p>
      <p class="side"><%= side.formLead %></p>
      <form action="<%= withLang('/form') %>" method="post">
        <input type="hidden" name="lang" value="<%= lang %>" />
        <label>
          <%= t.nameLabel %>
          <span class="side"><%= side.nameLabel %></span>
          <input type="text" name="name" placeholder="<%= t.namePlaceholder %>" required />
        </label>
        <label>
          <%= t.messageLabel %>
          <span class="side"><%= side.messageLabel %></span>
          <textarea name="message" rows="4" placeholder="<%= t.messagePlaceholder %>" required></textarea>
        </label>
        <button type="submit"><%= t.submit %></button>
      </form>
      <p><a href="<%= withLang('/') %>"><%= t.homeLink %></a></p>
    </main>
  </body>
</html>
