<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= t.resultTitle %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <main>
      <%- include('partials/lang-switch') %>
      <h1><%= t.resultTitle %></h1>
      <p class="side"><%= side.resultTitle %></p>
      <dl>
        <dt>name</dt>
        <dd><%= name %></dd>
        <dt>message</dt>
        <dd><%= message %></dd>
      </dl>
      <p>
        <a href="<%= withLang('/form') %>"><%= t.sendAgain %></a>
        ·
        <a href="<%= withLang('/') %>"><%= t.homeLink %></a>
      </p>
    </main>
  </body>
</html>
