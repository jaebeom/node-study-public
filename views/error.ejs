<!DOCTYPE html>
<html lang="<%= lang %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <main>
      <%- include('partials/lang-switch') %>
      <h1><%= message %></h1>
      <h2><%= error.status %></h2>
      <% if (error.stack) { %>
        <pre><%= error.stack %></pre>
      <% } %>
      <p><a href="<%= withLang('/') %>"><%= t.notFoundHome %></a></p>
    </main>
  </body>
</html>
